# Copia questo file in .env e inserisci la tua chiave. Il file .env non va mai pubblicato.

# Chiave API di OpenAI (obbligatoria)
OPENAI_API_KEY=sk-...

# Modello usato dall'orchestratore (back end) e dal data agent
OPENAI_MODEL=gpt-6-luna
# Facoltativo: un modello diverso solo per il data agent (es. piu' capace nello scrivere codice)
# OPENAI_MODEL_DATA=gpt-6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Facoltativo: alcuni modelli accettano gli strumenti solo con il ragionamento disattivato.
# Il codice se ne accorge da solo; impostalo a none solo per saltare il primo tentativo.
# OPENAI_REASONING_EFFORT=none

# Porte dei servizi (i valori predefiniti vanno bene)
BACKEND_PORT=3001
CHROMA_HOST=localhost
CHROMA_PORT=8001
DATA_AGENT_URL=http://localhost:8000

# --- Solo per la versione online (su Render si impostano nelle variabili del servizio) ---
# Con CHROMA_API_KEY impostata il back end usa Chroma Cloud invece del server ChromaDB locale.
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=
# Protezione dei costi (valori predefiniti): domande per visitatore all'ora, domande totali al giorno
# LIMITE_DOMANDE_ORA=20
# LIMITE_DOMANDE_GIORNO=300

# --- Facoltative (i valori predefiniti vanno bene) ---
# RAG: somiglianza minima perche' un paragrafo del manuale sia considerato pertinente (0-1)
# SOGLIA_SIMILARITA=0.3
# Cache delle analisi del data agent: numero massimo di risposte e durata in secondi
# CACHE_MAX_RISPOSTE=200
# CACHE_DURATA_SECONDI=21600
# Dataset alternativo da analizzare (deve rispettare lo schema di data_agent/schema.py)
# DATASET_CSV=
