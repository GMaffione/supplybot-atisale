{
  // Controllo dei tipi sul codice JavaScript (nessuna compilazione): TypeScript legge i commenti JSDoc
  // e i tipi ricavati da zod e segnala gli errori. Uso: npm run typecheck
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js"]
}
